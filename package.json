{
  "name": "stars-graph",
  "version": "0.0.0",
  "private": true,
  "description": "Explore your GitHub stars as an interactive similarity graph",
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data": "pnpm sync && pnpm embed && pnpm build-graph",
    "sync": "tsx scripts/sync.ts",
    "embed": "tsx scripts/embed.ts",
    "build-graph": "tsx scripts/build-graph.ts",
    "enrich:todo": "tsx scripts/enrich-todo.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  }
}
