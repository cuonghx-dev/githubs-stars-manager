{
  "name": "stars-graph",
  "version": "0.0.0",
  "private": true,
  "description": "Explore your GitHub stars as an interactive similarity graph",
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data": "pnpm sync && pnpm embed && pnpm build-graph",
    "sync": "tsx scripts/sync.ts",
    "embed": "tsx scripts/embed.ts",
    "build-graph": "tsx scripts/build-graph.ts",
    "enrich:todo": "tsx scripts/enrich-todo.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  }
}
